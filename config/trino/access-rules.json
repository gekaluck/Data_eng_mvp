{
  "catalogs": [
    {
      "user": "agent",
      "catalog": "gold",
      "allow": "read-only"
    },
    {
      "user": "agent",
      "catalog": ".*",
      "allow": "none"
    },
    {
      "user": "superset",
      "catalog": "gold",
      "allow": "read-only"
    },
    {
      "user": "superset",
      "catalog": ".*",
      "allow": "none"
    },
    {
      "catalog": ".*",
      "allow": "all"
    }
  ],
  "schemas": [
    {
      "user": "agent",
      "owner": false
    },
    {
      "user": "superset",
      "owner": false
    },
    {
      "owner": true
    }
  ],
  "tables": [
    {
      "user": "agent",
      "catalog": "gold",
      "schema": "crypto_dbt",
      "table": ".*",
      "privileges": ["SELECT"]
    },
    {
      "user": "agent",
      "privileges": []
    },
    {
      "user": "superset",
      "catalog": "gold",
      "schema": "crypto_dbt",
      "table": ".*",
      "privileges": ["SELECT"]
    },
    {
      "user": "superset",
      "privileges": []
    },
    {
      "privileges": [
        "SELECT",
        "INSERT",
        "DELETE",
        "UPDATE",
        "OWNERSHIP",
        "GRANT_SELECT"
      ]
    }
  ],
  "queries": [
    {
      "user": "agent",
      "allow": ["execute"]
    },
    {
      "user": "superset",
      "allow": ["execute"]
    },
    {
      "allow": ["execute", "view", "kill"]
    }
  ]
}
